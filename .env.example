# ========== LLM 配置 ==========
# 后端选择: "vertex_ai" 或 "ai_studio"
GEMINI_BACKEND=ai_studio

# Google AI Studio
GOOGLE_AI_STUDIO_KEY=your_ai_studio_key_here

# Google Vertex AI
VERTEX_AI_PROJECT_ID=your_project_id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_ACCESS_TOKEN=your_access_token_here

# Gemini 模型 (gemini-2.0-flash, gemini-1.5-pro, gemini-2.0-pro 等)
GEMINI_MODEL=gemini-2.0-flash

# ========== Suno 镜像站配置 ==========
SUNO_API_KEY=your_suno_mirror_api_key
SUNO_BASE_URL=https://api.vectorengine.ai
SUNO_MODEL=chirp-v4

# ========== Agent 配置 ==========
MAX_AGENT_STEPS=15
AGENT_TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=8192

# ========== 通用配置 ==========
LOG_LEVEL=INFO
OUTPUT_DIR=./output
